# Base64 of the je-portal-api service-account JSON key.
#   Linux/macOS : base64 -w0 .secrets/je-portal-api.json
#   PowerShell  : [Convert]::ToBase64String([IO.File]::ReadAllBytes(".secrets/je-portal-api.json"))
GCP_SERVICE_ACCOUNT_B64=

GCP_PROJECT_ID=je-jhapa-vaccination
BQ_DATASET=je_jhapa
BQ_LOCATION=asia-south1

# Shared secret KoBo's REST Service sends back on every webhook POST.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KOBO_WEBHOOK_SECRET=

# Set once the free Community-plan KoBo account and form exist (Phase 1).
KOBO_API_URL=https://kf.kobotoolbox.org
KOBO_ASSET_UID=
KOBO_API_TOKEN=
